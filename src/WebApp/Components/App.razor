<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="css/normalize.css" />
    <link rel="stylesheet" href="css/app.css" />
    <link rel="stylesheet" href="WebApp.styles.css" />
    <link rel="shortcut icon" href="images/favicon.png" />
    <script>
        // Apply theme immediately to prevent FOUC
        (function() {
            const themeCookie = document.cookie.split('; ').find(row => row.startsWith('theme='));
            let theme = themeCookie ? themeCookie.split('=')[1] : 'light';
            // Validate theme value to prevent XSS
            theme = (theme === 'dark' || theme === 'light') ? theme : 'light';
            document.documentElement.setAttribute('data-theme', theme);
        })();
        
        // Function to safely set theme attribute - called from Blazor
        window.setThemeAttribute = function(theme) {
            // Validate theme value to prevent XSS
            theme = (theme === 'dark' || theme === 'light') ? theme : 'light';
            document.documentElement.setAttribute('data-theme', theme);
        };
    </script>
    <HeadOutlet />
</head>

<body>
    <Routes />
    <script src="_framework/blazor.web.js"></script>
</body>

</html>
